# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Safe template. Copy to .env and fill in your real values.
# .env is git-ignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Polygon.io ────────────────────────────────────────────────────────────────
POLYGON_API_KEY=your_polygon_api_key_here

# ── Alpaca (Paper Trading) ────────────────────────────────────────────────────
# Get keys at: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # Use paper URL until Stage 5 goes live

# ── Environment Mode ─────────────────────────────────────────────────────────
# Options: development | production
ENV=development
